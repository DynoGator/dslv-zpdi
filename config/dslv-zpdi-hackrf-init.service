[Unit]
Description=DSLV-ZPDI PlutoSDRplus USB Initialisation
# Runs once after udev has settled USB devices so the PlutoSDRplus is visible to
# libusb before the main pipeline starts. Uses PlutoSDRplus_info (part of
# PlutoSDRplus-tools) to wake the device out of USB cold-start and log firmware.
After=udev.settle.service
Before=dslv-zpdi-preflight.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/PlutoSDRplus_info
# A missing device is not fatal — pipeline falls back to SimulatedHAL.
ExecStart=-/bin/sh -c 'echo "[dslv-zpdi-PlutoSDRplus-init] PlutoSDRplus ready" | systemd-cat -t dslv-zpdi-PlutoSDRplus-init'
TimeoutStartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dslv-zpdi-PlutoSDRplus-init

[Install]
WantedBy=multi-user.target
