[Unit]
Description=DSLV-ZPDI Production Pipeline (SPEC-011)
After=network.target chrony.service dslv-zpdi-preflight.service
Wants=chrony.service
Requires=dslv-zpdi-preflight.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=dynogator
Group=dynogator
WorkingDirectory=/home/dynogator/dslv-zpdi
ExecStart=/home/dynogator/dslv-zpdi/.venv/bin/python -m dslv_zpdi.main_pipeline --simulator
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/dynogator/dslv-zpdi/.env
Restart=on-failure
RestartSec=30
ExecStartPre=/bin/sleep 3
TimeoutStartSec=60
TimeoutStopSec=30
Nice=-5
IOSchedulingClass=realtime
IOSchedulingPriority=4
CPUAffinity=2 3
MemoryMax=2G
MemorySwapMax=0
LimitMEMLOCK=512M
LimitNOFILE=65536

# Systemd Sandboxing
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
PrivateTmp=yes
NoNewPrivileges=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=false
RestrictNamespaces=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service

# Read-write paths needed for pipeline operation
ReadWritePaths=/home/dynogator/dslv-zpdi/output /var/lib/dslv_zpdi /run/dslv-zpdi /dev/bus/usb

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dslv-zpdi
RuntimeDirectory=dslv-zpdi
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
