[Unit]
Description=DSLV-ZPDI Geekworm X-1202 UPS monitor (SPEC-004A.8)
After=network.target local-fs.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=i2c gpio
WorkingDirectory=/home/alphapi/dslv-zpdi
ExecStart=/home/alphapi/dslv-zpdi/.venv/bin/python /home/alphapi/dslv-zpdi/tools/x1202_ups_monitor.py
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/alphapi/dslv-zpdi/.env
Restart=on-failure
RestartSec=10
MemoryMax=128M
CPUAffinity=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dslv-zpdi-ups

[Install]
WantedBy=multi-user.target
