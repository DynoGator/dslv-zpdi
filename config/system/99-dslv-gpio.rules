# DSLV-ZPDI: Grant gpio group write access to exported GPIO sysfs nodes.
# Install to: /etc/udev/rules.d/99-dslv-gpio.rules
# Required for: X-1202 UPS battery monitor (GPIO 575/585 on RP1 pinctrl)
SUBSYSTEM=="gpio", ACTION=="add", RUN+="/bin/sh -c 'chgrp -R gpio /sys%p && chmod -R g+rw /sys%p'"
SUBSYSTEM=="gpio", KERNEL=="export", MODE="0220", GROUP="gpio"
SUBSYSTEM=="gpio", KERNEL=="unexport", MODE="0220", GROUP="gpio"
