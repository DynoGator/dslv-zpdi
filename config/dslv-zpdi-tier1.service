[Unit]
Description=DSLV-ZPDI Tier-1 WSS Ingestion Server (port 8443)
After=network.target dslv-zpdi.service
Wants=dslv-zpdi.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=alphapi
Group=dynogator
WorkingDirectory=/home/alphapi/dslv-zpdi
EnvironmentFile=/home/alphapi/dslv-zpdi/.env
ExecStart=/home/alphapi/dslv-zpdi/.venv/bin/python tier1_ingestion_server.py
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/alphapi/dslv-zpdi/src
Environment=ZPDI_SERVER_HOST=0.0.0.0
Environment=ZPDI_SERVER_PORT=8443
Restart=on-failure
RestartSec=15
MemoryMax=512M

ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=true
ReadWritePaths=/home/alphapi/dslv-zpdi/output /home/alphapi/dslv-zpdi/logs /var/lib/dslv_zpdi /run/dslv-zpdi

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dslv-zpdi-tier1

[Install]
WantedBy=multi-user.target
