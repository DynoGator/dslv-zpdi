[Unit]
Description=DSLV-ZPDI Web Dashboard (port 8080)
# Read-only HTML dashboard accessible from PiRepo LAN (10.219.125.x).
# Pixel 9 Pro XL and any Wi-Fi-connected device can browse http://10.219.125.69:8080/
After=network.target dslv-zpdi.service
Wants=dslv-zpdi.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
LimitNOFILE=65535
Type=simple
User=root
Group=root
WorkingDirectory=/home/alphapi/dslv-zpdi
ExecStart=/home/alphapi/dslv-zpdi/.venv/bin/gunicorn -b 0.0.0.0:8080 --workers 2 --threads 4 "dashboard.web_server:create_app()"
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/alphapi/dslv-zpdi/tools
Environment=DSLV_PRIMARY_OUTPUT_DIR=/home/alphapi/dslv-zpdi/output/primary
Environment=DSLV_SECONDARY_OUTPUT_DIR=/home/alphapi/dslv-zpdi/output/secondary
Environment=DSLV_WEBDASH_HOST=0.0.0.0
Environment=DSLV_WEBDASH_PORT=8080
Environment=DSLV_PIXEL_STATUS_URL=http://10.219.125.153:8444/api/status
Environment=DSLV_SDR_URI=ip:192.168.2.1
Environment=XDG_CONFIG_HOME=/run/dslv-zpdi
Restart=on-failure
RestartSec=5
MemoryMax=512M
CPUAffinity=1

ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=true
ReadWritePaths=/home/alphapi/dslv-zpdi/output /run/dslv-zpdi /root

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dslv-zpdi-webdash

[Install]
WantedBy=multi-user.target
