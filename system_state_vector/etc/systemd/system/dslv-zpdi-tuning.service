[Unit]
Description=DSLV-ZPDI System Tuning (CPU governor, USB power, Network buffers)
DefaultDependencies=no
After=sysinit.target local-fs.target
Before=dslv-zpdi-preflight.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/dynogator/dslv-zpdi/tools/system_tune.sh

[Install]
WantedBy=multi-user.target
