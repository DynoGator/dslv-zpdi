# Clean, high-contrast window decorations for PiXonyx/PiXonyx-like themes
# Active window: dark slate titlebar with white text and red close buttons
window.active.title.bg.color: #2C2C2C
window.active.label.text.color: #FFFFFF
window.active.button.unpressed.image.color: #E8E8E8
window.active.button.pressed.image.color: #C01C28

# Inactive window: muted gray titlebar with light gray text
window.inactive.title.bg.color: #4A4A4A
window.inactive.label.text.color: #D0D0D0
window.inactive.button.unpressed.image.color: #B0B0B0

# Menu and OSD readability
window.active.border.color: #1A1A1A
window.inactive.border.color: #3A3A3A
menu.items.bg.color: #2C2C2C
menu.items.text.color: #FFFFFF
menu.items.active.bg.color: #C01C28
menu.items.active.text.color: #FFFFFF
osd.bg.color: #2C2C2C
osd.label.text.color: #FFFFFF
