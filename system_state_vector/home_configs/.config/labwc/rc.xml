<?xml version="1.0"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">

  <!-- Touch controller mapped to primary HDMI output -->
  <touch deviceName="wch.cn USB2IIC_CTP_CONTROL (USB 3-2.2)" mapToOutput="HDMI-A-1" mouseEmulation="yes"/>

  <!-- Theme and fonts for a clean, readable UI -->
  <theme>
    <name>PiXonyx</name>
    <cornerRadius>4</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>yes</dropShadows>
    <font place="ActiveWindow">
      <name>DejaVu Sans</name>
      <size>12</size>
      <weight>Bold</weight>
      <slant>Normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>DejaVu Sans</name>
      <size>12</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
    <font place="OnScreenDisplay">
      <name>DejaVu Sans</name>
      <size>12</size>
      <weight>Bold</weight>
      <slant>Normal</slant>
    </font>
    <titlebar>
      <layout>:iconify,max,close</layout>
    </titlebar>
  </theme>

  <!-- Performance: disable window snapping and animation helpers -->
  <snapping>
    <range>0</range>
    <topMaximize>no</topMaximize>
  </snapping>

  <!-- Window switcher appearance -->
  <windowSwitcher show="yes" preview="no" outlines="yes" allWorkspaces="no">
    <fields>
      <field content="icon" width="10%" />
      <field content="title" width="90%" />
    </fields>
  </windowSwitcher>

</openbox_config>
